{
    "name": "configy",
    "description": "An automatic YAML to struct configuration parser for dlang",

    "authors": [ "Mathias 'Geod24' Lang" ],
    "license": "MIT",
    "copyright": "Copyright © 2021, BOSAGORA Foundation",

    "targetType": "library",

    "configurations": [
        {
            "name": "library"
        },
        {
            "name": "debug",
            "debugVersions": [ "ConfigFillerDebug" ]
        },
        {
            "name": "unittest",
            "dflags": ["-preview=dip1000"],
            "sourceFiles": [ "tests/unit/*.d" ]
        }
    ],

    "dependencies": {
	      "dyaml": ">=0.8.4"
    }
}
